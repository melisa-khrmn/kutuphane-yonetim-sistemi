  usecase "Iade et" as UC5
  usecase "Odunc suresini uzat" as UC6
  usecase "Kitap rezerve et / iptal et" as UC7
  usecase "Odunclerimi ve cezalarimi gor" as UC8
  usecase "Kitap ekle / guncelle / sil" as UC9
  usecase "Yazar ekle / guncelle / sil" as UC10
  usecase "Kategori yonet" as UC11
  usecase "Uyeleri yonet" as UC12
  usecase "Odunc ver / iade al" as UC13
  usecase "Gecikme raporu" as UC14
  usecase "Stok raporu" as UC15
  usecase "En cok okunanlar raporu" as UC16
}
U --> UC1
U --> UC2
U --> UC3
U --> UC4
